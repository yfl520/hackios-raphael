+
+impl ValueBc {
+    fn pointee(self, types: &BitcodeTypes) -> Option<u32> {
+        match self {
+            Self::Exact(t) => types.pointee(u64::from(t)),
+            Self::Pointer { pointee, .. } => Some(pointee),
+        }
+    }
+
+    fn canonical(self, cx: &FnCx<'_>) -> Self {
+        match self {
+            Self::Exact(t) => match (
+                cx.bc_types.pointee(u64::from(t)),
+                cx.bc_types.ty(u64::from(t)).and_then(|t| cx.types.get(t)),
+            ) {
+                (Some(pointee), Some(Type::Ptr { space })) => Self::Pointer {
+                    pointee,
+                    space: *space,
+                },
+                _ => self,
+            },
+            _ => self,
+        }
+    }
